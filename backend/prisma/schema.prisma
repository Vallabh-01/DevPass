generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String   @id @default(uuid())
  githubId    String   @unique
  username    String   @unique
  displayName String?
  email       String?
  avatarUrl   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects       Project[]
  notes          Note[]
  learningItems  LearningItem[]
  certifications Certification[]
  githubAccount  GitHubAccount?
  reports        Report[]
  aiReviews      AIReview[]
}

model Project {
  id          String   @id @default(uuid())
  userId      String

  title       String
  description String?
  techStack   String?
  githubUrl   String?
  liveDemoUrl String?

  timelineStart DateTime?
  timelineEnd   DateTime?

  challenges         String?
  solutions          String?
  lessonsLearned     String?
  futureImprovements String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  screenshots ProjectScreenshot[]
  notes       Note[]
}

model ProjectScreenshot {
  id        String   @id @default(uuid())
  projectId String

  imageUrl  String
  caption   String?
  sortOrder Int      @default(0)

  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Note {
  id        String  @id @default(uuid())
  userId    String
  projectId String?

  title   String
  content String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
}

model LearningItem {
  id     String @id @default(uuid())
  userId String

  technology String
  progress   Int    @default(0)
  status     String @default("learning")

  startedAt   DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Certification {
  id     String @id @default(uuid())
  userId String

  name        String
  issuer      String?
  credentialUrl String?
  issuedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model GitHubAccount {
  id     String @id @default(uuid())
  userId String @unique

  githubUserId String @unique
  username     String
  accessToken  String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  repositories GitHubRepository[]
}

model GitHubRepository {
  id             String @id @default(uuid())
  githubAccountId String

  githubRepositoryId BigInt
  name              String
  fullName          String
  description       String?
  htmlUrl           String?

  stars     Int @default(0)
  forks     Int @default(0)
  language  String?
  isPrivate Boolean @default(false)

  lastSyncedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  githubAccount GitHubAccount @relation(fields: [githubAccountId], references: [id], onDelete: Cascade)
  commits      GitHubCommit[]
  languages    GitHubLanguage[]

  @@unique([githubAccountId, githubRepositoryId])
}

model GitHubCommit {
  id           String @id @default(uuid())
  repositoryId String

  githubCommitId String
  message       String?
  committedAt   DateTime?

  createdAt DateTime @default(now())

  repository GitHubRepository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([repositoryId, githubCommitId])
}

model GitHubLanguage {
  id           String @id @default(uuid())
  repositoryId String

  language String
  bytes    Int

  repository GitHubRepository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([repositoryId, language])
}

model Report {
  id     String @id @default(uuid())
  userId String

  type      String
  startDate DateTime
  endDate   DateTime

  content Json

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AIReview {
  id     String @id @default(uuid())
  userId String

  repositoryId String?
  title        String

  inputSummary String
  suggestions  Json

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}